{
  "name": "@transcdr/sdk",
  "version": "0.9.0",
  "description": "Official TypeScript SDK for the Transcdr video transcoding API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "transcdr",
    "video",
    "transcoding",
    "av1",
    "hls",
    "sdk"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transcdr/transcdr-sdk-typescript.git"
  },
  "homepage": "https://transcdr.com/docs",
  "bugs": {
    "url": "https://github.com/transcdr/transcdr-sdk-typescript/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
